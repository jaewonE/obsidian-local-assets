{
	"name": "obsidian-local-assets",
	"version": "1.3.0",
	"description": "Local assets Obsidian plugin: unified local drop/paste file renaming plus remote asset localization with configurable destinations, cache validation, batch commands, and safer link rewriting.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node tests/run-pure-tests.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"assets",
		"attachments",
		"markdown",
		"paste",
		"drag-drop",
		"rename",
		"download"
	],
	"engines": {
		"node": ">=18"
	},
	"author": "JaewonE",
	"license": "GPL-3.0-only",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@eslint/json": "^2.0.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	}
}
